{
  "extends": [
    "config:recommended",
    "security:gomodIndirectSecurityUpdates",
    "helpers:pinGitHubActionDigests"
  ],
  "osvVulnerabilityAlerts": true,
  "labels": [
    "dependencies"
  ],
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "rebase",
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am"
    ]
  },
  "ignorePaths": [
    "devbox.json",
    "devbox.lock"
  ],
  "ignoreDeps": [
    "github.com/zitadel/terraform-provider-zitadel/v2",
    "github.com/pulumi/terraform-plugin-sdk/v2"
  ],
  "packageRules": [
    {
      "description": "Group all non-major updates together",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "Automerge all non-major updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Do not automerge major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Bump the Go toolchain — stdlib CVEs land there and govulncheck reds otherwise wait for a human. config:recommended never touches the go directive, so without this rule the version simply stops moving: this repository sat on go 1.25.12 while govulncheck reported five stdlib advisories all fixed in 1.25.13, and the red vuln check blocked the auto-merge Renovate had already armed on #35. The nine other public repositories got this rule in the 2026-08-14 sweep; this one was missed.",
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "go"
      ],
      "enabled": true,
      "rangeStrategy": "bump"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "automerge": true
  }
}
